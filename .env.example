# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string (local or Atlas).
MONGO_DB_URI=mongodb://127.0.0.1:27017/talkify

# Long random string used to sign session tokens. The server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# API port. The Vite dev server proxies /api and /socket.io here.
PORT=5001

# "development" locally. Only affects which extra Socket.IO origins are allowed.
NODE_ENV=development

# Optional: extra comma-separated origins allowed to open a Socket.IO connection.
# CLIENT_ORIGINS=https://example.com

# Optional: MongoDB server for the integration tests (npm test). A throwaway
# database is created on it for each run and dropped afterwards.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017
